---
layout: null
---
[
  {% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "category": {{ post.categories | first | default: "Article" | replace: "-", " " | capitalize | jsonify }},
    "date": {{ post.date | date: "%B %-d, %Y" | jsonify }},
    "description": {{ post.description | default: post.excerpt | strip_html | strip_newlines | truncatewords: 25 | jsonify }}
  },
  {% endfor %}
  {% for pub in site.data.publications %}
  {
    "title": {{ pub.title | jsonify }},
    "url": {{ '/publications/#' | append: pub.id | relative_url | jsonify }},
    "category": "Publication",
    "date": {{ pub.venue | jsonify }},
    "description": {{ pub.abstract | strip_html | strip_newlines | truncatewords: 25 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
