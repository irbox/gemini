{
  "name": "lovelace-journal",
  "version": "1.0.0",
  "description": "The Lovelace Journal - Modern Jekyll static research publication and engineering blog",
  "type": "module",
  "scripts": {
    "build": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo run --release -- build",
    "build:release": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo run --release -- build",
    "preview": "npx serve dist",
    "test": "node --test test/*.test.js && (PATH=\"$HOME/.cargo/bin:$PATH\" cargo test)",
    "start": "npx serve dist"
  },
  "keywords": [
    "lovelace-journal",
    "jekyll",
    "engineering-blog",
    "frontier-ai",
    "static-site"
  ],
  "author": "The Lovelace Lab",
  "license": "MIT",
  "devDependencies": {
    "sass": "^1.108.2"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "liquidjs": "^10.30.1",
    "marked": "^18.2.0"
  }
}
